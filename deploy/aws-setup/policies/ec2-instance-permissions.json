{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadResearchRagParams",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:aws:ssm:__AWS_REGION__:__ACCOUNT_ID__:parameter/research-rag",
        "arn:aws:ssm:__AWS_REGION__:__ACCOUNT_ID__:parameter/research-rag/*"
      ]
    },
    {
      "Sid": "PullECRImages",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": "*"
    }
  ]
}
